<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.App.Pages.ModuleDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock
                x:Name="ModuleDescription"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                OpticalMarginAlignment="TrimSideBearings" />

            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ModuleDetailVersionLabel" x:Uid="ModuleDetailVersionLabel" Grid.Column="0" Text="Version" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="ModuleVersion" />

                <TextBlock x:Name="ModuleDetailSourceLabel" x:Uid="ModuleDetailSourceLabel" Grid.Column="0" Grid.Row="1" Text="Source" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" Grid.Row="1" x:Name="ModuleSource" />

                <TextBlock x:Name="ModuleDetailStateLabel" x:Uid="ModuleDetailStateLabel" Grid.Column="0" Grid.Row="2" Text="State" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" Grid.Row="2" x:Name="ModuleState" />
            </Grid>

            <TextBlock
                x:Name="ModuleDetailPermissions"
                x:Uid="ModuleDetailPermissions"
                Text="Permissions"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <ItemsControl x:Name="PermissionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <InfoBar
                            Title="{Binding}"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Margin="0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                <Button
                    x:Name="ModuleDetailUninstallButton"
                    x:Uid="ModuleDetailUninstallButton"
                    Content="Uninstall"
                    Click="UninstallButton_Click" />

                <Button
                    x:Name="ModuleDetailReinstallButton"
                    x:Uid="ModuleDetailReinstallButton"
                    Content="Re-enable"
                    Click="ReinstallButton_Click"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>
