<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ShuRuk.App</RootNamespace>
    <AssemblyName>ShuRuk</AssemblyName>
    <VersionMajor>0</VersionMajor>
    <VersionMinor>1</VersionMinor>
    <VersionPatch>0</VersionPatch>
    <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <DisableEmbeddedXbf>true</DisableEmbeddedXbf>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <DefaultResourceLanguage>zh-CN</DefaultResourceLanguage>
    <PackageArchitecture>x64</PackageArchitecture>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationManifest>app.manifest</ApplicationManifest>

    <ApplicationIcon>Assets\ShuRuk.ico</ApplicationIcon>
    <DefaultLanguage>zh-cn</DefaultLanguage>


    <UseWindowsForms>False</UseWindowsForms>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <PackageCertificateThumbprint>3439F0B573694DD7798AE4FE8C89405B6C41CBA4</PackageCertificateThumbprint>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Extensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShuRuk.Runtime\ShuRuk.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Strings\**\*.resw" CopyToOutputDirectory="PreserveNewest" Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Sync manifest versions from csproj version components.
       XmlPeek reads current version, XmlPoke writes only when different (avoids unnecessary file touch).
       从csproj版本分量同步manifest版本：先读当前版本，仅当不同时写入(避免不必要的文件改动)。 -->
  <Target Name="SyncManifestVersions" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ManifestVersion>$(Version).0</_ManifestVersion>
    </PropertyGroup>
    <XmlPeek
      XmlInputPath="app.manifest"
      Query="/asm1:assembly/asm1:assemblyIdentity/@version"
      Result="_AppManifestVer"
      Namespaces="&lt;Namespace Prefix='asm1' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;" />
    <XmlPeek
      XmlInputPath="package.appxmanifest"
      Query="/f:Package/f:Identity/@Version"
      Result="_AppxManifestVer"
      Namespaces="&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
    <XmlPoke
      Condition="'@(_AppManifestVer)' != '$(_ManifestVersion)'"
      XmlInputPath="app.manifest"
      Query="/asm1:assembly/asm1:assemblyIdentity/@version"
      Value="$(_ManifestVersion)"
      Namespaces="&lt;Namespace Prefix='asm1' Uri='urn:schemas-microsoft-com:asm.v1' /&gt;" />
    <XmlPoke
      Condition="'@(_AppxManifestVer)' != '$(_ManifestVersion)'"
      XmlInputPath="package.appxmanifest"
      Query="/f:Package/f:Identity/@Version"
      Value="$(_ManifestVersion)"
      Namespaces="&lt;Namespace Prefix='f' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
  </Target>

</Project>
