<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.App.Views.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Single-row layout: content fills entire area, top bar floats above -->
    <!-- 单行布局：内容占满全部，顶栏浮在上层 -->
    <Grid>
        <!-- Content area / 内容区 - bottom layer / 底层 -->
        <Frame
            x:Name="ContentFrame"
            Margin="0"
            IsNavigationStackEnabled="False" />
        <!-- Floating top bar / 悬浮顶栏 - top layer / 上层 -->
        <Border
            x:Name="TopBar"
            Margin="16,16,16,0"
            VerticalAlignment="Top"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1">
            <Grid
                x:Name="TopBarGrid"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                Padding="6,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar
                    x:Name="SubBar"
                    AutomationProperties.Name="Module tab bar"
                    AutomationProperties.AutomationId="ModuleSubBar"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    SelectionChanged="SubBar_SelectionChanged">
                    <SelectorBarItem
                        x:Name="ModulePageInstalledTab"
                        x:Uid="ModulePageInstalledTab"
                        IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="ModulePageDiscoverTab"
                        x:Uid="ModulePageDiscoverTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <StackPanel
                    x:Name="SearchSortPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="SearchSortTransform" X="0" />
                    </StackPanel.RenderTransform>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Width="240"
                        Margin="0"
                        x:Uid="ModulePageSearchBox"
                        AutomationProperties.AutomationId="ModuleSearchBox"
                        QueryIcon="Find"
                        TextChanged="SearchBox_TextChanged" />

                    <DropDownButton
                        x:Name="SortButton"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="ModuleSortButton"
                        ToolTipService.ToolTip="{x:Bind SortTooltipText}">
                        <DropDownButton.Content>
                            <FontIcon Glyph="&#xE8CB;" />
                        </DropDownButton.Content>

                        
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem Text="{x:Bind SortNameText}" GroupName="SortGroup" Tag="name" IsChecked="True" Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem Text="{x:Bind SortDownloadsText}" GroupName="SortGroup" Tag="downloads" Click="SortMenuItem_Click" />
                                <RadioMenuFlyoutItem Text="{x:Bind SortUpdatedText}" GroupName="SortGroup" Tag="updated" Click="SortMenuItem_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="SearchBox.(Visibility)" Value="Collapsed" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>
