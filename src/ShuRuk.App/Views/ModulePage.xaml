<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.App.Views.ModulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Single-row layout: content fills entire area, top bar floats above / 单行布局：内容占满全部，顶栏浮在上层 -->
    <Grid>
        <!-- Content area / 内容区 - bottom layer / 底层 -->
        <Frame
            x:Name="ContentFrame"
            Margin="0"
            IsNavigationStackEnabled="False" />
        <!-- Floating top bar / 悬浮顶栏 - top layer, mica material / 上层，云母材质 -->
        <Border
            x:Name="TopBar"
            Margin="16,16,16,0"
            VerticalAlignment="Top"
            CornerRadius="8"
            Background="{ThemeResource SystemControlTransientBackgroundBrush}"
            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
            BorderThickness="1"
            Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar
                    x:Name="SubBar"
                    AutomationProperties.Name="Module tab bar"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    SelectionChanged="SubBar_SelectionChanged">
                    <SelectorBarItem
                        x:Name="ModulePageInstalledTab"
                        x:Uid="ModulePageInstalledTab"
                        IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem
                        x:Name="ModulePageDiscoverTab"
                        x:Uid="ModulePageDiscoverTab">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    MinHeight="36"
                    MaxHeight="36"
                    Margin="12,0,0,0"
                    x:Uid="ModulePageSearchBox"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />

                <DropDownButton
                    x:Name="SortButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Visibility="Collapsed"
                    Content="{x:Bind SortRatingText}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{x:Bind SortRatingText}" Tag="rating" Click="SortMenuItem_Click" />
                            <MenuFlyoutItem Text="{x:Bind SortDownloadsText}" Tag="downloads" Click="SortMenuItem_Click" />
                            <MenuFlyoutItem Text="{x:Bind SortUpdatedText}" Tag="updated" Click="SortMenuItem_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>
        </Border>
    </Grid>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
                <VisualState.Setters>
                    <Setter Target="SearchBox.(Visibility)" Value="Collapsed" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>
