<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.App.Views.ModuleDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,16,32,16">
        <StackPanel Spacing="20" MaxWidth="800" HorizontalAlignment="Stretch">

            <!-- Header: icon + module name / 头部：图标+模块名 -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image x:Name="ModuleIcon"
                       Source="ms-appx:///Assets/ShuRuk.ico"
                       Width="48" Height="48"
                       VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ModuleDescription"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    OpticalMarginAlignment="TrimSideBearings" />
            </StackPanel>

            <!-- Info card: ID / Author / Version / Source / State / Description / 信息卡片 -->
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="20">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ModuleDetailIdLabel" x:Uid="ModuleDetailIdLabel"
                               Grid.Column="0" Grid.Row="0"
                               Text="ID"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               x:Name="ModuleId"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="ModuleDetailAuthorLabel" x:Uid="ModuleDetailAuthorLabel"
                               Grid.Column="0" Grid.Row="1"
                               Text="Author"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="1"
                               x:Name="ModuleAuthor"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="ModuleDetailVersionLabel" x:Uid="ModuleDetailVersionLabel"
                               Grid.Column="0" Grid.Row="2"
                               Text="Version"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="2"
                               x:Name="ModuleVersion"
                               Style="{StaticResource BodyTextBlockStyle}" />

                    <TextBlock x:Name="ModuleDetailSourceLabel" x:Uid="ModuleDetailSourceLabel"
                               Grid.Column="0" Grid.Row="3"
                               Text="Source"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="3"
                               x:Name="ModuleSourceValue"
                               Style="{StaticResource BodyTextBlockStyle}" />

                    <TextBlock x:Name="ModuleDetailStateLabel" x:Uid="ModuleDetailStateLabel"
                               Grid.Column="0" Grid.Row="4"
                               Text="State"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="4"
                               x:Name="ModuleStateValue"
                               Style="{StaticResource BodyTextBlockStyle}" />

                    <TextBlock x:Name="ModuleDetailDescriptionLabel" x:Uid="ModuleDetailDescriptionLabel"
                               Grid.Column="0" Grid.Row="5"
                               Text="Description"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Grid.Row="5"
                               x:Name="ModuleDescriptionText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- SelectorBar: Introduction / Changelog / 选择栏切换：介绍/更新记录 -->
            <SelectorBar x:Name="DetailSelectorBar"
                         SelectionChanged="DetailSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="ModuleDetailIntroTab" x:Uid="ModuleDetailIntroTab"
                                 IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="ModuleDetailChangelogTab" x:Uid="ModuleDetailChangelogTab">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xECC5;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- Content panels / 内容面板 -->
            <Grid>
                <TextBlock x:Name="IntroPlaceholder"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Visible" />
                <TextBlock x:Name="ChangelogPlaceholder"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Action buttons: Install / Uninstall / Update / Re-enable / 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="ModuleDetailInstallButton"
                    x:Uid="ModuleDetailInstallButton"
                    Content="Install"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="InstallButton_Click"
                    Visibility="Collapsed" />

                <Button
                    x:Name="ModuleDetailUninstallButton"
                    x:Uid="ModuleDetailUninstallButton"
                    Content="Uninstall"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="UninstallButton_Click" />

                <Button
                    x:Name="ModuleDetailUpdateButton"
                    x:Uid="ModuleDetailUpdateButton"
                    Content="Update"
                    Click="UpdateButton_Click"
                    Visibility="Collapsed" />

                <Button
                    x:Name="ModuleDetailReinstallButton"
                    x:Uid="ModuleDetailReinstallButton"
                    Content="Re-enable"
                    Click="ReinstallButton_Click"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>
