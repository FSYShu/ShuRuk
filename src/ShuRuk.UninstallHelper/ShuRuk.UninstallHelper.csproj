<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ShuRuk.UninstallHelper</RootNamespace>
    <AssemblyName>ShuRukUninstallHelper</AssemblyName>
    <Version>0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Pack as NuGet for module consumption / 打包为NuGet供模块引用 -->
    <IsPackable>true</IsPackable>
    <PackageId>Shuruk.UninstallHelper</PackageId>
    <Authors>ShuRuk</Authors>
    <Description>ShuRuk uninstall helper: registry refcount and runtime cleanup / 卸载辅助程序</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>