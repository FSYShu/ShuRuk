<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ShuRuk.UninstallHelper</RootNamespace>
    <AssemblyName>ShuRukUninstallHelper</AssemblyName>
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionPatch>0</VersionPatch>
    <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Pack as NuGet for module consumption / 打包为NuGet供模块引用 -->
    <IsPackable>true</IsPackable>
    <PackageId>ShuRuk.UninstallHelper</PackageId>
    <Authors>ShuRuk</Authors>
    <Description>ShuRuk uninstall helper: registry refcount and runtime cleanup / 卸载辅助程序</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Single-file trimmed publish (non-self-contained): ~50-150KB exe embedded into MSIX.
         Only active during dotnet publish, not dotnet build (avoids IL Linker at build time).
         裁剪单文件非自包含发布：约50-150KB exe嵌入MSIX。仅publish时生效，避免build时加载IL Linker。 -->
    <PublishSingleFile Condition="'$(IsPublishing)' == 'true'">true</PublishSingleFile>
    <PublishTrimmed Condition="'$(IsPublishing)' == 'true'">true</PublishTrimmed>
    <EnableCompressionInSingleFile Condition="'$(IsPublishing)' == 'true'">true</EnableCompressionInSingleFile>
    <SelfContained Condition="'$(IsPublishing)' == 'true'">false</SelfContained>
  </PropertyGroup>
</Project>