<Page
    x:Class="ShuRuk.Runtime.Views.ChangelogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShuRuk.Runtime.Views"
    xmlns:models="using:ShuRuk.Runtime.Models"
    xmlns:controls="using:ShuRuk.Runtime.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Brush x:Key="PrereleaseBadgeBrush">#B8831E</Brush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Brush x:Key="PrereleaseBadgeBrush">#E0A838</Brush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="SegmentTemplate" x:DataType="models:ChangelogSegment">
            <StackPanel Spacing="8">
                <ctk:MarkdownTextBlock Text="{x:Bind MarkdownText, Mode=OneTime}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       UsePipeTables="True"
                                       UseEmphasisExtras="True"
                                       UseTaskLists="True"
                                       UseAutoLinks="True"
                                       UseSoftlineBreakAsHardlineBreak="True"
                                       IsTextSelectionEnabled="True"
                                       Visibility="{x:Bind TextVisibility, Mode=OneTime}"
                                       Loading="MarkdownTextBlock_Loading"
                                       Loaded="MarkdownTextBlock_Loaded"
                                       SizeChanged="MarkdownTextBlock_SizeChanged" />
                <Grid Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                      HorizontalAlignment="Left">
                    <Image Source="{x:Bind ImageSource, Mode=OneWay}"
                           Stretch="Uniform"
                           MaxWidth="{x:Bind ImageMaxWidth, Mode=OneWay}"
                           Visibility="{x:Bind ImageLoadedVisibility, Mode=OneWay}"
                           ImageOpened="Image_ImageOpened"
                           ImageFailed="Image_ImageFailed" />
                    <ProgressRing IsActive="True"
                                  Width="32" Height="32"
                                  Margin="0,8"
                                  HorizontalAlignment="Left"
                                  Visibility="{x:Bind LoadingVisibility, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Sticky overlay template: mirrors card version info column -->
        <!-- sticky覆盖层模板:镜像卡片版本信息列 -->
        <DataTemplate x:Key="StickyOverlayTemplate" x:DataType="models:ChangelogEntry">
            <StackPanel Spacing="2" Margin="0,8,16,0" Width="100">
                <controls:MarqueeText Text="{x:Bind Version, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       ClipWidth="84"
                                       ClipHeight="24"
                                       HorizontalAlignment="Left" />
                <TextBlock Text="{x:Bind Date, Mode=OneTime}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Border Visibility="{x:Bind PrereleaseVisibility, Mode=OneTime}"
                        Background="Transparent"
                        BorderBrush="{ThemeResource PrereleaseBadgeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Margin="0,2,0,0">
                    <TextBlock Text="{x:Bind PrereleaseLabel, Mode=OneTime}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrereleaseBadgeBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Sticky overlay template for "History versions" section header -->
        <!-- "历史版本"区域标题的sticky覆盖层模板 -->
        <DataTemplate x:Key="StickyHistoryOverlayTemplate" x:DataType="models:ChangelogEntry">
            <StackPanel Spacing="2" Margin="0,8,16,0" Width="100">
                <controls:MarqueeText Text="{x:Bind HistoryVersionsLabel, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       ClipWidth="84"
                                       ClipHeight="24"
                                       HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,0,0,0">
        <ScrollViewer x:Name="ChangelogScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Visible"
                      ViewChanged="ChangelogScrollViewer_ViewChanged">
            <Grid x:Name="ContentPanel" Margin="0,16,24,16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page title / 页标题 -->
                <TextBlock Grid.Row="0"
                           Text="{x:Bind PageTitleText}"
                           Style="{StaticResource TitleTextBlockStyle}" />

                <!-- Cache/offline indicator InfoBar / 缓存/离线指示InfoBar -->
                <InfoBar Grid.Row="1"
                         x:Name="CacheInfoBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Warning"
                         Margin="0,0,0,12" />

                <ItemsRepeater Grid.Row="2" x:Name="ChangelogRepeater">

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ChangelogEntry">
                        <Grid Margin="0,0,0,10" Loaded="CardGrid_Loaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Top divider for history cards: spans both columns -->
                            <!-- history卡片顶部分隔线:贯穿两列 -->
                            <Border Grid.ColumnSpan="2"
                                    VerticalAlignment="Top"
                                    Height="1"
                                    Margin="0,-5,0,0"
                                    Visibility="{x:Bind HistoryTopDividerVisibility, Mode=OneWay}"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Left column: version info or "History versions" label -->
                            <!-- 左列:版本信息或"历史版本"标签 -->
                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,8,16,0">
                                <!-- "History versions" label: only for history cards when collapsed -->
                                <!-- "历史版本"标签:仅history卡片折叠时 -->
                                <controls:MarqueeText Text="{x:Bind HistoryVersionsLabel, Mode=OneWay}"
                                                       Visibility="{x:Bind HistoryLabelVisibility, Mode=OneWay}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       ClipWidth="84"
                                                       ClipHeight="24"
                                                       HorizontalAlignment="Left" />
                                <!-- Version detail: featured cards or history cards when expanded -->
                                <!-- 版本详情:featured卡片或history卡片展开时 -->
                                <StackPanel x:Name="VersionDetailPanel" Visibility="{x:Bind VersionDetailVisibility, Mode=OneWay}" Spacing="2">
                                    <controls:MarqueeText Text="{x:Bind Version, Mode=OneWay}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           ClipWidth="84"
                                                           ClipHeight="24"
                                                           HorizontalAlignment="Left" />
                                    <TextBlock Text="{x:Bind Date, Mode=OneTime}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Border Visibility="{x:Bind PrereleaseVisibility, Mode=OneTime}"
                                            Background="Transparent"
                                            BorderBrush="{ThemeResource PrereleaseBadgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0">
                                        <TextBlock Text="{x:Bind PrereleaseLabel, Mode=OneTime}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PrereleaseBadgeBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Card with segments (text + image alternating), collapsible height -->
                            <!-- 卡片含文字图片交替段,可折叠高度 -->
                            <Grid Grid.Column="1"
                                  x:Name="CardContentGrid"
                                  Visibility="{x:Bind FeaturedContentVisibility, Mode=OneWay}"
                                  Padding="12,12"
                                  CornerRadius="6"
                                  MaxHeight="{x:Bind CardMaxHeight, Mode=OneWay}"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Title row: release name + inline expand button for history-collapsed -->
                                <!-- 标题行:release名称+history折叠时的内联展开按钮 -->
                                <Grid Grid.Row="0"
                                      Visibility="{x:Bind TitleRowVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ReleaseName, Mode=OneTime}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <!-- Inline expand button: only for history cards when collapsed -->
                                    <!-- 内联展开按钮:仅history卡片折叠时 -->
                                    <Button Grid.Column="1"
                                            Click="ExpandButton_Click"
                                            Tag="{x:Bind Mode=OneTime}"
                                            Visibility="{x:Bind InlineExpandVisibility, Mode=OneWay}"
                                            Padding="8,4"
                                            CornerRadius="6"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{x:Bind ExpandButtonText, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind ExpandButtonGlyph, Mode=OneWay}" FontSize="12" />
                                    </Button>
                                </Grid>
                                <!-- Divider below title (hidden for history-collapsed) -->
                                <!-- 标题下分隔线(history折叠时隐藏) -->
                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Visibility="{x:Bind DividerVisibility, Mode=OneWay}"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <ItemsRepeater x:Name="FeaturedContentRepeater"
                                               Grid.Row="1"
                                               ItemsSource="{x:Bind VisibleSegments, Mode=OneTime}"
                                               SizeChanged="CardContent_SizeChanged"
                                               ItemTemplate="{StaticResource SegmentTemplate}"
                                               Margin="0,8,0,0">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="4" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </Grid>
                            <!-- History card content: Expander as direct child with card styling -->
                            <!-- history卡片内容:Expander直接子元素带卡片样式 -->
                            <Expander Grid.Column="1"
                                       Visibility="{x:Bind HistoryContentVisibility, Mode=OneWay}"
                                       IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                       Expanding="HistoryExpander_Expanding"
                                       Collapsed="HistoryExpander_Collapsed"
                                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                       BorderThickness="1"
                                       CornerRadius="6"
                                       Padding="12,12"
                                       HorizontalAlignment="Stretch"
                                       HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind ReleaseName, Mode=OneTime}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </Expander.Header>
                                <Expander.Content>
                                    <ItemsRepeater ItemsSource="{x:Bind VisibleSegments, Mode=OneTime}"
                                                   ItemTemplate="{StaticResource SegmentTemplate}"
                                                   Margin="0,4,0,0">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="4" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                </Expander.Content>
                            </Expander>

                            <!-- Bottom expand/collapse button overlaid on card bottom center -->
                            <!-- 底部展开/收起按钮叠加卡片底部居中 -->
                            <Border x:Name="BottomButtonBorder"
                                    Grid.Column="1"
                                    Visibility="{x:Bind BottomButtonVisibility, Mode=OneWay}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8"
                                    CornerRadius="6"
                                    Padding="0"
                                    Canvas.ZIndex="5"
                                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                                <Button Click="ExpandButton_Click"
                                        Tag="{x:Bind Mode=OneTime}"
                                        Padding="8,4"
                                        CornerRadius="6"
                                        AutomationProperties.Name="{x:Bind ExpandButtonText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind ExpandButtonText, Mode=OneWay}" />
                                        <FontIcon Glyph="{x:Bind ExpandButtonGlyph, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <!-- Sticky overlay layer: per-version sticky panels outside ScrollViewer -->
        <!-- sticky覆盖层:每版本独立面板在ScrollViewer外 -->
        <Canvas x:Name="StickyLayerContainer" IsHitTestVisible="False" />

        <!-- Filter selector floating on top, hidden until data loaded / 过滤选择器,数据加载后显示 -->
        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,18,24,0">
            <Border x:Name="ImageToggleBorder"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                <ToggleButton x:Name="ShowImagesToggle"
                              IsChecked="True"
                              Click="ShowImagesToggle_Click"
                              Padding="8,5"
                              Height="32"
                              MinWidth="0"
                              AutomationProperties.Name="{x:Bind ShowImagesA11yName}">
                    <Grid>
                        <FontIcon x:Name="ShowImagesIcon" Glyph="&#xE8B9;" FontSize="14" />
                        <ProgressRing x:Name="ShowImagesProgress"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Width="14" Height="14" />
                    </Grid>
                </ToggleButton>
            </Border>
            <Border x:Name="FilterBorder"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                <DropDownButton x:Name="FilterButton"
                                Content="{x:Bind FilterAllText}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="{x:Bind FilterAllText}" Tag="all" Click="FilterMenuItem_Click" />
                            <MenuFlyoutItem Text="{x:Bind FilterExcludePrereleaseText}"
                                            Tag="exclude-prerelease"
                                            Click="FilterMenuItem_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Border>
            <!-- Refresh button / 刷新按钮 -->
            <Border x:Name="RefreshBorder"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                <Button x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        Padding="8,5"
                        Height="32"
                        Width="34"
                        AutomationProperties.Name="{x:Bind RefreshA11yName}">
                    <Grid Width="14" Height="14">
                        <FontIcon x:Name="RefreshIcon" Glyph="&#xE72C;" FontSize="14" />
                        <ProgressRing x:Name="RefreshProgress"
                                      IsActive="False"
                                      Visibility="Collapsed"
                                      Width="14" Height="14" />
                    </Grid>
                </Button>
            </Border>
        </StackPanel>

        <!-- Empty state / 空状态 -->
        <StackPanel x:Name="EmptyState"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <FontIcon Glyph="&#xECC5;"
                      FontSize="48"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16" />
            <TextBlock Text="{x:Bind EmptyTitle, Mode=OneTime}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind EmptyDescription, Mode=OneTime}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       OpticalMarginAlignment="TrimSideBearings" />
        </StackPanel>

        <!-- Error state (similar layout to empty but distinct icon/text) -->
        <!-- 错误状态(布局类似空状态但图标文字不同) -->
        <StackPanel x:Name="ErrorState"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8">
            <FontIcon Glyph="&#xE783;"
                      FontSize="48"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,16" />
            <TextBlock x:Name="ErrorTitleText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ErrorDescriptionText"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       OpticalMarginAlignment="TrimSideBearings" />
        </StackPanel>

        <!-- Loading overlay / 加载遮罩 -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="64" Height="64" />
                <TextBlock x:Name="LoadingTextBlock"
                           HorizontalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}"
                           OpticalMarginAlignment="TrimSideBearings" />
            </StackPanel>
        </Grid>


        <!-- Version quick nav buttons / 版本快速导航按钮 -->
        <Border x:Name="NavButtonsPanel"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                CornerRadius="6"
                Padding="2">
            <StackPanel Orientation="Vertical" Spacing="2">
                <Border x:Name="PrevVersionBorder"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                    <Button x:Name="PrevVersionButton"
                        Click="PrevVersionButton_Click"
                        Width="36" Height="36"
                        Padding="0"
                        ToolTipService.ToolTip="{x:Bind PrevVersionText}"
                        AutomationProperties.Name="{x:Bind PrevVersionText}">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                </Border>
                <Border x:Name="NextVersionBorder"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Background="{ThemeResource SystemControlTransientBackgroundBrush}">
                    <Button x:Name="NextVersionButton"
                        Click="NextVersionButton_Click"
                        Width="36" Height="36"
                        Padding="0"
                        ToolTipService.ToolTip="{x:Bind NextVersionText}"
                        AutomationProperties.Name="{x:Bind NextVersionText}">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sticky collapse button follows expanded card bottom, clamps to viewport -->
        <!-- 跟随展开卡片底部的收起按钮,限制在视口内 -->
        <Border x:Name="CollapseFloatingBorder"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="76,0,0,12"
                CornerRadius="6"
                Padding="0"
                Opacity="0"
                Visibility="Collapsed"
                Background="{ThemeResource SystemControlTransientBackgroundBrush}">
            <Button x:Name="CollapseFloatingButton"
                    Padding="8,4"
                    CornerRadius="6"
                    Click="CollapseFloatingButton_Click"
                    ToolTipService.ToolTip="{x:Bind CollapseTooltipText}"
                    AutomationProperties.Name="{x:Bind CollapseTooltipText}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{x:Bind CollapseButtonText}" />
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</Page>
