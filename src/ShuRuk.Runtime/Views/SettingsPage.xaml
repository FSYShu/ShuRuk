<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.Runtime.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="24,16,24,0">
        <StackPanel Spacing="4">

            <!-- Page title / 页标题 -->
            <TextBlock
                Text="{x:Bind PageTitleText}"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,16" />

            <!-- General Section / 常规分区 -->
            <TextBlock
                x:Name="SettingsLanguageSectionHeader"
                Text="{x:Bind LanguageSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,0,0,4" />

            <ctk:SettingsCard
                x:Name="LanguageCard"
                Header="{x:Bind LanguageHeader}"
                Description="{x:Bind LanguageDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        AutomationProperties.Name="Language selection"
                        Width="200"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <InfoBar
                x:Name="RestartInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="SettingsRestartButton"
                        Content="{x:Bind RestartButtonText}"
                        HorizontalAlignment="Right"
                        Click="RestartButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Theme Section / 主题分区 -->
            <ctk:SettingsCard
                x:Name="ThemeCard"
                Header="{x:Bind ThemeHeader}"
                Description="{x:Bind ThemeDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        AutomationProperties.Name="Theme selection"
                        Width="200"
                        SelectionChanged="ThemeComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <!-- TestMode Section / 测试模式分区 -->
            <ctk:SettingsExpander
                x:Name="TestModeExpander"
                Header="{x:Bind TestModeHeader}"
                Description="{x:Bind TestModeDescription}">
                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEC7A;" />
                </ctk:SettingsExpander.HeaderIcon>
                <ctk:SettingsExpander.Content>
                    <ToggleSwitch
                        x:Name="TestModeToggle"
                        Toggled="TestModeToggle_Toggled" />
                </ctk:SettingsExpander.Content>
                <ctk:SettingsExpander.Items>
                    <ctk:SettingsCard
                        Header="{x:Bind TestModeFillHeader}"
                        Description="{x:Bind TestModeFillDescription}">

                        <ctk:SettingsCard.Content>
                            <ComboBox
                                x:Name="TestModeFillCombo"
                                Width="200"
                                SelectionChanged="TestModeFillCombo_SelectionChanged">
                                <ComboBoxItem x:Name="TestModeFillEmptyItem" Content="{x:Bind TestModeFillEmpty}" />
                                <ComboBoxItem x:Name="TestModeFillFullItem" Content="{x:Bind TestModeFillFull}" />
                            </ComboBox>
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind ChangelogRepoHeader}"
                        Description="{x:Bind ChangelogRepoDescription}">

                        <ctk:SettingsCard.Content>
                            <TextBox
                                x:Name="ChangelogRepoTextBox"
                                Width="240"
                                PlaceholderText="owner/repo"
                                TextChanged="ChangelogRepoTextBox_TextChanged" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind ChangelogSectionHeader}"
                        Description="{x:Bind ChangelogSectionDescription}">

                        <ctk:SettingsCard.Content>
                            <TextBox
                                x:Name="ChangelogSectionTextBox"
                                Width="240"
                                TextChanged="ChangelogSectionTextBox_TextChanged" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                </ctk:SettingsExpander.Items>
            </ctk:SettingsExpander>



            <!-- About Section / 关于分区 -->
            <TextBlock
                x:Name="SettingsAboutSectionHeader"
                Text="{x:Bind AboutSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,16,0,4" />

            <ctk:SettingsExpander
                Description="{x:Bind AppVersionDescription}">
                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </ctk:SettingsExpander.HeaderIcon>
                <ctk:SettingsExpander.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind AppNameHeader}" />
                        <TextBlock Text="{x:Bind AppSubtitle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ctk:SettingsExpander.Header>
                <ctk:SettingsExpander.Items>
                    <ctk:SettingsCard
                        Header="{x:Bind SdkVersionHeader}"
                        Description="{x:Bind SdkVersionDescription}" />
                    <ctk:SettingsCard
                        Header="{x:Bind ToolkitVersionHeader}"
                        Description="{x:Bind ToolkitVersionDescription}" />
                </ctk:SettingsExpander.Items>
            </ctk:SettingsExpander>

        </StackPanel>
    </ScrollViewer>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>