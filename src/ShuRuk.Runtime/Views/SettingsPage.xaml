<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.Runtime.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ShuRuk.Runtime.Controls"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">

    <Page.Resources>
        <ResourceDictionary>
            <!-- ToggleMenuFlyoutItem template with MarqueeText / 使用跑马灯的ToggleMenuFlyoutItem模板 -->
            <ControlTemplate x:Key="MarqueeToggleMenuFlyoutItemTemplate" TargetType="ToggleMenuFlyoutItem">
                <Grid
                    x:Name="LayoutRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Height="31"
                    Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        x:Name="CheckIcon"
                        Grid.Column="0"
                        Glyph="&#xE73E;"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,0,16,0"
                        Opacity="0" />

                    <controls:MarqueeText
                        Grid.Column="1"
                        Text="{TemplateBinding Text}"
                        Height="27"
                        VerticalAlignment="Center" />

                    <TextBlock
                        x:Name="KeyboardAcceleratorTextBlock"
                        Grid.Column="2"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                        Margin="24,0,0,0"
                        Visibility="Collapsed" />

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LayoutRoot" Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Opacity">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="1" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Unchecked" />
                            <VisualState x:Name="HiddenChecked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Opacity">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer Padding="24,0,24,0">
        <StackPanel Spacing="4" Margin="0,16">

            <!-- Page title / 页标题 -->
            <TextBlock
                Text="{x:Bind PageTitleText}"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,16" />

            <!-- General Section / 常规分区 -->
            <TextBlock
                x:Name="SettingsLanguageSectionHeader"
                Text="{x:Bind LanguageSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,0,0,4" />

            <ctk:SettingsCard
                x:Name="LanguageCard"
                Header="{x:Bind LanguageHeader}"
                Description="{x:Bind LanguageDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        AutomationProperties.Name="Language selection"
                        Width="200"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <InfoBar
                x:Name="RestartInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="SettingsRestartButton"
                        Content="{x:Bind RestartButtonText}"
                        HorizontalAlignment="Right"
                        Click="RestartButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Theme Section / 主题分区 -->
            <ctk:SettingsCard
                x:Name="ThemeCard"
                Header="{x:Bind ThemeHeader}"
                Description="{x:Bind ThemeDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        AutomationProperties.Name="Theme selection"
                        Width="200"
                        SelectionChanged="ThemeComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <!-- TestMode Section / 测试模式分区 -->
            <ctk:SettingsExpander
                x:Name="TestModeExpander"
                Header="{x:Bind TestModeHeader}"
                Description="{x:Bind TestModeDescription}">
                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEC7A;" />
                </ctk:SettingsExpander.HeaderIcon>
                <ctk:SettingsExpander.Content>
                    <ToggleSwitch
                        x:Name="TestModeToggle"
                        Toggled="TestModeToggle_Toggled" />
                </ctk:SettingsExpander.Content>
                <ctk:SettingsExpander.Items>
                    <ctk:SettingsCard
                        Header="{x:Bind TestModeFillHeader}"
                        Description="{x:Bind TestModeFillDescription}">

                        <ctk:SettingsCard.Content>
                            <ComboBox
                                x:Name="TestModeFillCombo"
                                Width="200"
                                SelectionChanged="TestModeFillCombo_SelectionChanged">
                                <ComboBoxItem x:Name="TestModeFillEmptyItem" Content="{x:Bind TestModeFillEmpty}" />
                                <ComboBoxItem x:Name="TestModeFillFullItem" Content="{x:Bind TestModeFillFull}" />
                            </ComboBox>
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind TestModeCoverageHeader}"
                        Description="{x:Bind TestModeCoverageDescription}">

                        <ctk:SettingsCard.Content>
                            <Button
                                x:Name="CoverageScopeButton"
                                Width="200"
                                Height="32"
                                HorizontalAlignment="Right"
                                HorizontalContentAlignment="Stretch"
                                Padding="10,0,12,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="CoverageScopeText"
                                        Text="{x:Bind TestModeCoverageAll}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Grid.Column="0" />
                                    <AnimatedIcon
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Width="12"
                                        MinHeight="32"
                                        Margin="6,7,0,5"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="1">
                                        <AnimatedIcon.Source>
                                            <animatedvisuals:AnimatedChevronDownSmallVisualSource/>
                                        </AnimatedIcon.Source>
                                    </AnimatedIcon>
                                </Grid>
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <ToggleMenuFlyoutItem
                                            x:Name="CoverageSelectAllItem"
                                            Text="{x:Bind TestModeCoverageAll}"
                                            Template="{StaticResource MarqueeToggleMenuFlyoutItemTemplate}"
                                            Click="CoverageSelectAll_Click" />
                                        <MenuFlyoutSeparator MinWidth="200" MaxWidth="200" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="InstalledItem"
                                            Text="{x:Bind TestModeCoverageInstalled}"
                                            Template="{StaticResource MarqueeToggleMenuFlyoutItemTemplate}"
                                            Click="CoverageItem_Click" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="DiscoverItem"
                                            Text="{x:Bind TestModeCoverageDiscover}"
                                            Template="{StaticResource MarqueeToggleMenuFlyoutItemTemplate}"
                                            Click="CoverageItem_Click" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="ChangelogItem"
                                            Text="{x:Bind TestModeCoverageChangelog}"
                                            Template="{StaticResource MarqueeToggleMenuFlyoutItemTemplate}"
                                            Click="CoverageItem_Click" />
                                        <ToggleMenuFlyoutItem
                                            x:Name="MonitorItem"
                                            Text="{x:Bind TestModeCoverageMonitor}"
                                            Template="{StaticResource MarqueeToggleMenuFlyoutItemTemplate}"
                                            Click="CoverageItem_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind ChangelogRepoHeader}"
                        Description="{x:Bind ChangelogRepoDescription}">
                        <ctk:SettingsCard.Content>
                            <TextBox
                                x:Name="ChangelogRepoTextBox"
                                Width="200"
                                PlaceholderText="owner/repo"
                                TextChanged="ChangelogRepoTextBox_TextChanged" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind ChangelogSectionHeader}"
                        Description="{x:Bind ChangelogSectionDescription}">
                        <ctk:SettingsCard.Content>
                            <TextBox
                                x:Name="ChangelogSectionTextBox"
                                Width="200"
                                TextChanged="ChangelogSectionTextBox_TextChanged" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                </ctk:SettingsExpander.Items>
            </ctk:SettingsExpander>

            <!-- About Section / 关于分区 -->
            <TextBlock
                x:Name="SettingsAboutSectionHeader"
                Text="{x:Bind AboutSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,16,0,4" />

            <ctk:SettingsExpander
                Description="{x:Bind AppVersionDescription}">
                <ctk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </ctk:SettingsExpander.HeaderIcon>
                <ctk:SettingsExpander.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind AppNameHeader}" />
                        <TextBlock Text="{x:Bind AppSubtitle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ctk:SettingsExpander.Header>
                <ctk:SettingsExpander.Items>
                    <ctk:SettingsCard
                        Header="{x:Bind SdkVersionHeader}"
                        Description="{x:Bind SdkVersionDescription}">
                        <ctk:SettingsCard.Content>
                            <ImageIcon Source="ms-appx:///Assets/windows-app-sdk-icon.png" Width="24" Height="24" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind ToolkitVersionHeader}"
                        Description="{x:Bind ToolkitVersionDescription}">
                        <ctk:SettingsCard.Content>
                            <ImageIcon
                                Source="ms-appx:///Assets/windows-community-toolkit-icon.png"
                                Width="24" Height="24" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                    <ctk:SettingsCard
                        Header="{x:Bind DotnetToolkitVersionHeader}"
                        Description="{x:Bind DotnetToolkitVersionDescription}">
                        <ctk:SettingsCard.Content>
                            <ImageIcon
                                Source="ms-appx:///Assets/dotnet-community-toolkit-icon.png"
                                Width="24" Height="24" />
                        </ctk:SettingsCard.Content>
                    </ctk:SettingsCard>
                </ctk:SettingsExpander.Items>
            </ctk:SettingsExpander>

        </StackPanel>
    </ScrollViewer>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
            <VisualState x:Name="WideState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="1024" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="MediumState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="768" />
                </VisualState.StateTriggers>
            </VisualState>
            <VisualState x:Name="NarrowState">
                <VisualState.StateTriggers>
                    <AdaptiveTrigger MinWindowWidth="0" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</Page>
