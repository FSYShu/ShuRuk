<?xml version="1.0" encoding="utf-8"?>
<!-- Framework package manifest for ShuRuk.Runtime MSIX.
     Installed once, shared by all modules. No Applications section (framework only).
     框架包清单：安装一份所有模块共用，无Applications节(仅框架)。 -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity
    Name="ShuRuk.Runtime"
    Publisher="CN=FSYShu"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="B2C3D4E5-F6A7-8901-BCDE-F23456789012" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>ShuRuk Runtime</DisplayName>
    <PublisherDisplayName>ShuRuk</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>
</Package>