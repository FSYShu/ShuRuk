<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ShuRuk.Runtime.Controls.MarqueeText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" HorizontalAlignment="Left">
        <Grid.Clip>
            <RectangleGeometry x:Name="ClipGeometry" />
        </Grid.Clip>
        <Canvas>
            <TextBlock x:Name="MainText"
                       Canvas.Top="1"
                       Loaded="MainText_Loaded"
                       SizeChanged="MainText_SizeChanged">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="MainTransform" X="0" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>
    </Grid>
</UserControl>