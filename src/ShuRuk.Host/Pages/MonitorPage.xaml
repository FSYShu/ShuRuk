<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.Host.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16">
        <ListView x:Name="MonitorListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding ModuleName}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Opacity="0.7" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="3" Value="{Binding CpuUsagePercent}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>