<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.Host.Pages.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <GridView
            x:Name="InstalledGridView"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="InstalledGridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="260" Height="140" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding Description}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SourceBadge}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding StateText}" Opacity="0.6" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Visibility="Collapsed"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16">
            <FontIcon
                Glyph="&#xE7B8;"
                FontSize="48"
                Opacity="0.3"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="InstalledPageEmptyTitle"
                x:Uid="InstalledPageEmptyTitle"
                Text="No modules installed"
                Style="{StaticResource SubtitleTextBlockStyle}"
                HorizontalAlignment="Center"
                Opacity="0.6" />
            <TextBlock
                x:Name="InstalledPageEmptyDescription"
                x:Uid="InstalledPageEmptyDescription"
                Text="Discover and install modules to get started."
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Opacity="0.4"
                TextWrapping="Wrap"
                OpticalMarginAlignment="TrimSideBearings" />
            <Button
                x:Name="InstalledPageEmptyDiscoverButton"
                x:Uid="InstalledPageEmptyDiscoverButton"
                Content="Browse modules"
                HorizontalAlignment="Center"
                Click="EmptyDiscoverButton_Click" />
        </StackPanel>
    </Grid>
</Page>
