<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ShuRuk.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="4">

            <!-- General Section / 常规分区 -->
            <TextBlock
                x:Name="SettingsLanguageSectionHeader"
                Text="{x:Bind LanguageSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,0,0,4" />

            <ctk:SettingsCard
                x:Name="LanguageCard"
                Header="{x:Bind LanguageHeader}"
                Description="{x:Bind LanguageDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="LanguageComboBox"
                        Width="200"
                        SelectionChanged="LanguageComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <InfoBar
                x:Name="RestartInfoBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Visibility="Collapsed">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="SettingsRestartButton"
                        Content="{x:Bind RestartButtonText}"
                        HorizontalAlignment="Right"
                        Click="RestartButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Theme Section / 主题分区 -->
            <ctk:SettingsCard
                x:Name="ThemeCard"
                Header="{x:Bind ThemeHeader}"
                Description="{x:Bind ThemeDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE706;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Content>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Width="200"
                        SelectionChanged="ThemeComboBox_SelectionChanged" />
                </ctk:SettingsCard.Content>
            </ctk:SettingsCard>

            <!-- About Section / 关于分区 -->
            <TextBlock
                x:Name="SettingsAboutSectionHeader"
                Text="{x:Bind AboutSectionHeader}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,20,0,4" />

            <ctk:SettingsCard
                Description="{x:Bind AppVersionDescription}">
                <ctk:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE946;" />
                </ctk:SettingsCard.HeaderIcon>
                <ctk:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind AppNameHeader}" />
                        <TextBlock Text="{x:Bind AppSubtitle}"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ctk:SettingsCard.Header>
            </ctk:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>
